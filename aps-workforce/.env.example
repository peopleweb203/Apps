# APS AI Workforce - environment template.
# Copy to .env ONLY on the machine that runs the workforce. Never commit .env.
# The prototype runs fully without any of these (simulation mode).

# Workforce mode is set in workforce_config.yaml (workforce.mode). Keep "simulation"
# until a live provider has passed a supervised smoke test.

# --- Anthropic (Claude API) - optional, chargeable ---
# Used only when: mode=live AND providers.anthropic.verified=true AND a human
# approved the chargeable call (or the provider is listed in
# budget.authorized_chargeable_providers). Leave blank to keep it disabled.
ANTHROPIC_API_KEY=

# --- Not yet implemented (listed so nothing gets invented) ---
# GEMINI_API_KEY=            # no Gemini adapter exists yet
# GITHUB_TOKEN=              # GitHub not wired into the workforce yet; use least-privilege fine-grained token
# GOOGLE_APPLICATION_CREDENTIALS=   # Drive not wired yet
